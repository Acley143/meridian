<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.meridian</groupId>
  <artifactId>core-service</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.0</spring-boot.version>
    <flyway.version>10.15.0</flyway.version>
    <testcontainers.version>1.20.1</testcontainers.version>
  </properties>

  <!-- No parent POM here (ADR-0015's reactor aggregator is a plain pom, not
       spring-boot-starter-parent), so nothing was otherwise pinning every Spring-managed
       dependency (Jackson's several modules, SLF4J, etc.) to one mutually-compatible version
       set. Without this, Maven's ordinary "nearest wins" resolution picks a different version
       for each transitively-pulled Jackson module depending on which dependency happened to
       declare it first, which is exactly what caused three separate runtime-only failures this
       session (a NoSuchFieldError from jackson-datatype-jsr310 expecting a newer
       jackson-annotations than what got resolved, after an earlier fix pinned jackson-annotations
       down to fix a DIFFERENT mismatch; none of this showed up at compile time). Importing Spring
       Boot's own BOM is the standard fix a spring-boot-starter-parent would normally give for
       free. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.meridian</groupId>
      <artifactId>contracts-generated-java</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.3</version>
      <scope>runtime</scope>
    </dependency>
    <!-- Forward-only SQL migrations (ADR-0019 session): checked in under
         src/main/resources/db/migration, applied by Flyway on startup and
         by tests against a Testcontainers Postgres. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>${flyway.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <version>${flyway.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>3.7.0</version>
    </dependency>
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-avro-serializer</artifactId>
      <version>7.6.1</version>
    </dependency>
    <!-- jackson-annotations and slf4j-api versions now come from the spring-boot-dependencies
         BOM import above; see that block's comment for what this replaced. Both are
         transitively pulled by kafka-avro-serializer/kafka-clients at versions incompatible with
         the rest of the (now BOM-managed) Jackson/logging stack; the BOM import resolves them to
         Spring Boot 3.3.0's own consistent set instead of whatever "nearest wins" would otherwise
         pick. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <version>${spring-boot.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>kafka</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Contract-conformance testing (Session 05d, Task 3): validates real HTTP responses
         against contracts/openapi/service-api.yaml itself, not hand-written expectations. No
         other OpenAPI validation tooling exists elsewhere in this repo to reuse (checked
         contracts/README.md and contracts/tests/, per Task 3's own instruction). REST-assured
         doubles as the real HTTP client Task 4.4 requires (an actual request/response over the
         wire, not MockMvc), so the same test drives both the HTTP call and its OpenAPI
         validation. -->
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>5.4.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>swagger-request-validator-restassured</artifactId>
      <version>2.42.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <repositories>
    <repository>
      <id>confluent</id>
      <url>https://packages.confluent.io/maven/</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Without this, @PathVariable/@RequestParam without an explicit name (e.g.
               @PathVariable String portfolioId) fails at request time; Spring Boot's
               starter-parent sets this by default; this project has no parent POM, so nothing
               otherwise did. Found by actually calling the running application's endpoints. -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.43.0</version>
        <configuration>
          <java>
            <googleJavaFormat/>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
