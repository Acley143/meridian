{
  "type": "record",
  "name": "Tick",
  "namespace": "com.meridian.contracts",
  "doc": "A single market data observation for an instrument. See docs/domain-model.md#tick.",
  "fields": [
    { "name": "instrument_id", "type": "string", "doc": "Instrument this observation is for." },
    {
      "name": "price",
      "type": { "type": "bytes", "logicalType": "decimal", "precision": 38, "scale": 8 },
      "doc": "Last-traded or mid price in `currency`. Decimal (precision 38, scale 8) per ADR-0004/ADR-0013."
    },
    { "name": "currency", "type": "string", "doc": "ISO 4217 currency price is quoted in." },
    {
      "name": "event_time",
      "type": { "type": "long", "logicalType": "timestamp-micros" },
      "doc": "UTC instant the tick was generated at the source. Per ADR-0005."
    },
    {
      "name": "ingest_time",
      "type": { "type": "long", "logicalType": "timestamp-micros" },
      "doc": "UTC instant Meridian's ingest stage received this tick. Per ADR-0005."
    },
    {
      "name": "scenario_id",
      "type": "string",
      "default": "",
      "doc": "Identifies the seeded simulated market scenario this tick belongs to (ADR-0011, ADR-0006) -- the same scenario_id reproduces a byte-identical tick stream. Added after this schema's first version; empty string is the BACKWARD-compatible default for a producer that predates ADR-0011. Propagated through to RiskSnapshot.scenario_id for end-to-end lineage."
    }
  ]
}
